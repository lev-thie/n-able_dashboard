# NOC-Wanddisplay – Konfiguration
# Kopieren nach config/config.env, ausfüllen, dann deployen.
# Auf dem Raspberry Pi liegt die Datei unter /etc/noc-dashboard/config.env (nur root/noc lesbar).
# Ohne Zugangsdaten startet das Dashboard im Demo-Modus mit Beispieldaten.

# --- Anzeigezeiten -----------------------------------------------------------
TIMEZONE=Europe/Berlin
DISPLAY_START=07:30
DISPLAY_END=17:00
# Wochentage mit Dashboard (1=Mo … 7=So). An allen anderen Tagen läuft ganztägig die Uhr.
DISPLAY_DAYS=1,2,3,4,5,6,7
# Schriftgröße: 1 = Standard (passt sich der Bildschirmauflösung an).
# Größer z. B. 1.15 oder 1.3 – dann passen weniger Zeilen auf eine Seite und es wird häufiger umgeblättert.
UI_SCALE=1

# --- N-able GraphQL (Server, CPU, RAM, Datenträger, Agent-Status) ------------
NABLE_GRAPHQL_URL=https://api.n-able.com/graphql
NABLE_API_TOKEN=
# Optional: nur diese Organisationen (IDs, kommagetrennt)
NABLE_ORGANIZATION_IDS=
# Inventar (Serverliste) alle 10 min, Messwerte alle 60 s
NABLE_INVENTORY_INTERVAL=600
NABLE_METRICS_INTERVAL=60

# --- N-central REST (aktive Probleme, gestoppte Dienste) – optional ----------
# Server ohne https://, z. B. ncentral.example.de
NCENTRAL_SERVER=
# „N-central User-API Token (JWT)“: Administration → User Management → Users → API Access
NCENTRAL_JWT=
NCENTRAL_INTERVAL=120
# notificationState-Werte, die als kritisch gelten (alle anderen = Warnung).
# Die beobachteten Werte stehen im Log: journalctl -u noc-dashboard | grep notificationState
NCENTRAL_CRITICAL_STATES=5
# Aktive Probleme, deren Dienstname hierauf passt, zählen als „gestoppter Dienst“
NCENTRAL_SERVICE_PATTERN=(?i)service|dienst

# --- UniFi Site Manager API (Kundenstandorte) --------------------------------
# API-Schlüssel erstellen unter https://unifi.ui.com/api
UNIFI_API_KEY=
UNIFI_API_URL=https://api.ui.com
UNIFI_INTERVAL=60

# --- Schwellwerte in % --------------------------------------------------------
CPU_WARN=75
CPU_CRIT=90
RAM_WARN=80
RAM_CRIT=90
DISK_WARN=85
DISK_CRIT=95

# --- Alarmton bei neuen kritischen Problemen ---------------------------------
ALARM_SOUND=/opt/noc-dashboard/sounds/alarm.wav
# Leer = Standardausgabe. HDMI explizit z. B.: ALARM_ALSA_DEVICE=hdmi:CARD=vc4hdmi0,DEV=0
# Verfügbare Geräte: aplay -L
ALARM_ALSA_DEVICE=
# Ton nur während der Dashboard-Anzeigezeit
ALARM_ONLY_DURING_DISPLAY=true
# Mindestabstand zwischen zwei Tönen (Sekunden)
ALARM_COOLDOWN=60
# Erinnerung, solange kritische Probleme bestehen (Minuten, 0 = aus)
ALARM_REPEAT_MINUTES=0

# --- Sonstiges ----------------------------------------------------------------
# Lokaler Port des Dashboards (nur auf dem Pi erreichbar)
PORT=8765
BIND=127.0.0.1
LOG_LEVEL=INFO
DEMO_MODE=false
