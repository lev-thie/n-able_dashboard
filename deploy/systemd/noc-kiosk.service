[Unit]
Description=NOC-Wanddisplay Kiosk (Chromium im Vollbild über Cage)
After=systemd-user-sessions.service plymouth-quit-wait.service noc-dashboard.service
Wants=noc-dashboard.service dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionPathExists=/dev/tty1

[Service]
Type=simple
User=kiosk
PAMName=noc-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Warten, bis das Backend antwortet (max. 60 s), dann Chromium starten
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do curl -sf http://127.0.0.1:8080/healthz >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStart=/opt/noc-dashboard/deploy/kiosk-start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
